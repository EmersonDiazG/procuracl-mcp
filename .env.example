# Copy this file to .env. Demo works without credentials; live uses the official APIs.
PROCURA_DATA_MODE=demo
CHILE_PUBLIC_MARKET_TICKET=
PROCURA_DATABASE_PATH=data/procura.db
# Keep safety margin below ChileCompra's documented 10,000 daily maximum.
PROCURA_DAILY_REQUEST_LIMIT=9500
PROCURA_CACHE_TTL_SECONDS=300
# Fail reasonably fast when the upstream API is unavailable.
PROCURA_API_TIMEOUT_SECONDS=30
